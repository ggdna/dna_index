{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "dna_index",

  // 1-2 sentence summary about this repo.
  "summary": "DNA layer: index-guide, index-template.jsonc and /index skill describing each repo; keeps its guide and template out of the published package.",

  // 1-3 bullet points: the problem space.
  "domain": ["index.jsonc: summary, domain, interfaces of a repo"],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "helix": "DNA engine: instantiates dna/ into the repo (dev)",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "dna_ggdna": "layer",
      "dna_ggsuite": "layer",
      "dna_tssuite": "layer",
      "dna_dart": "layer",
      "dna_gg": "parent layer",
    },
  },
}
